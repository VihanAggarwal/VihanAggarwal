+"""CPU tests for the canonical-mask builder forked before CUDA init (track_1_short/canonical_mask.py).
+
+Run from the repo root: python -m pytest tools/tests -q
+Needs the GPT-2 tokenizer files in tiktoken's cache (TIKTOKEN_CACHE_DIR).
+"""
+import os
+import subprocess
+import sys
+import textwrap
+import time
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+import torch.distributed as dist
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+
+from track_1_short.canonical_mask import BackgroundCanonicalMask, build_canonical_mask  # noqa: E402
+
+VOCAB = 50304  # next_multiple_of_n(50257, 128), the trainer's padded vocabulary
+
+
+@pytest.fixture(scope="module")
+def reference_mask() -> np.ndarray:
+    return build_canonical_mask(VOCAB)
+
+
+@pytest.fixture(scope="module")
+def gloo_group():
+    if not dist.is_initialized():
+        os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+        os.environ.setdefault("MASTER_PORT", "29533")
+        dist.init_process_group("gloo", rank=0, world_size=1)
+    yield
+    dist.destroy_process_group()
+
+
+def test_prefork_build_matches_inline_build(reference_mask, gloo_group):
+    builder = BackgroundCanonicalMask(VOCAB, owner=True)
+    assert builder.pid and builder.go is not None
+    time.sleep(0.5)  # the child is idle until start(): nothing is written yet
+    assert not builder.buf.numpy().any()
+    start = time.perf_counter()
+    builder.start()
+    builder.wait()
+    print(f"\nbuild after start(): {time.perf_counter() - start:.2f} s")
+    out = torch.zeros(VOCAB, VOCAB // 8, dtype=torch.uint8)
+    builder.collect(out)
+    assert np.array_equal(out.numpy(), reference_mask)
+    assert builder.buf is None and builder.pid is None
+
+
+def test_non_owner_forks_nothing():
+    builder = BackgroundCanonicalMask(VOCAB, owner=False)
+    assert builder.pid is None and builder.buf is None
+    builder.start()
+    builder.wait()
+
+
+def test_child_exits_when_trainer_exits_before_the_clock():
+    """A trainer that dies during warmup closes the pipe; its child must not outlive it."""
+    script = textwrap.dedent(f"""
+        import sys; sys.path.insert(0, {str(ROOT)!r})
+        from track_1_short.canonical_mask import BackgroundCanonicalMask
+        b = BackgroundCanonicalMask({VOCAB}, owner=True)
+        print(b.pid, flush=True)
+        raise SystemExit(7)  # never starts the build
+    """)
+    proc = subprocess.run([sys.executable, "-c", script], capture_output=True, text=True, env=os.environ)
+    assert proc.returncode == 7
+    child = int(proc.stdout.split()[0])
+    deadline = time.time() + 30
+    while time.time() < deadline and Path(f"/proc/{child}").exists():
+        time.sleep(0.1)
+    state = Path(f"/proc/{child}/stat").read_text().split()[2] if Path(f"/proc/{child}").exists() else "gone"
+    assert state in ("gone", "Z"), f"child {child} still running ({state})"
+
+
+def test_failed_child_falls_back_to_inline_build(reference_mask, gloo_group, monkeypatch):
+    builder = BackgroundCanonicalMask(VOCAB, owner=True)
+    os.kill(builder.pid, 9)  # the child dies before building
+    time.sleep(0.2)
+    try:
+        builder.start()
+    except BrokenPipeError:
+        # Writing to a pipe whose reader died: the trainer must survive it and build inline.
+        pytest.fail("start() must not raise when the child died")
+    builder.wait()
+    out = torch.zeros(VOCAB, VOCAB // 8, dtype=torch.uint8)
+    builder.collect(out)
+    assert np.array_equal(out.numpy(), reference_mask)
